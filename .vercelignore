# Flutter build output served via .vercel/output/static/ (pre-built output API)
# build/web must NOT be uploaded — it exceeds 100MB Vercel limit
build/
.dart_tool/

# Android/iOS/desktop platform builds — web only on Vercel
android/
ios/
macos/
windows/
linux/

# Large development assets
.pub-cache/

# Git
.git/

# Misc
*.log
.DS_Store

# Stray zero-byte file that confuses Vercel Go framework detection
cmd
