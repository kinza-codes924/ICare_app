# Flutter build output — pre-built locally, build/web is uploaded to Vercel
# build/web is the outputDirectory in vercel.json — do NOT exclude it
.dart_tool/

# Android/iOS/desktop platform builds — web only on Vercel
android/
ios/
macos/
windows/
linux/

# Large development assets
.pub-cache/

# Git
.git/

# Misc
*.log
.DS_Store

# Stray zero-byte file that confuses Vercel Go framework detection
cmd
