{
  "version": 2,
  "buildCommand": "",
  "outputDirectory": "build/web",
  "installCommand": "",
  "headers": [
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" },
        { "key": "Cross-Origin-Opener-Policy", "value": "unsafe-none" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "unsafe-none" }
      ]
    }
  ],
  "routes": [
    {
      "src": "/flutter_bootstrap\\.js",
      "dest": "/flutter_bootstrap.js"
    },
    {
      "src": "/flutter\\.js",
      "dest": "/flutter.js"
    },
    {
      "src": "/flutter_service_worker\\.js",
      "dest": "/flutter_service_worker.js"
    },
    {
      "src": "/main\\.dart\\.js",
      "dest": "/main.dart.js"
    },
    {
      "src": "/manifest\\.json",
      "dest": "/manifest.json"
    },
    {
      "src": "/version\\.json",
      "dest": "/version.json"
    },
    {
      "src": "/share-modal\\.js",
      "dest": "/share-modal.js"
    },
    {
      "src": "/favicon\\.png",
      "dest": "/favicon.png"
    },
    {
      "src": "/icare_logo\\.png",
      "dest": "/icare_logo.png"
    },
    {
      "src": "/icons/(.*)",
      "dest": "/icons/$1"
    },
    {
      "src": "/canvaskit/(.*)",
      "dest": "/canvaskit/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
